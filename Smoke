<!DOCTYPE html>

<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Salt & Smoke — Menu</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;0,900;1,400;1,600&family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Raleway:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
  :root {
    --ink:       #1a1410;
    --parchment: #f5ede0;
    --smoke:     #2c2420;
    --ember:     #c8611a;
    --gold:      #d4a043;
    --ash:       #8a7a6e;
    --cream:     #fdf6ec;
    --rust:      #8b3a1a;
    --highlight: #e8925a;
    --tag-star:  #2d5a1b;
    --tag-star-bg: #e8f5e0;
    --tag-anchor-bg: #fff3e0;
    --tag-anchor: #8b4513;
    --tag-decoy-bg: #fce4d6;
    --tag-decoy:  #7b1f1f;
    --analysis:  #1a3a5c;
    --analysis-bg: #e8f0f8;
  }

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

body {
background-color: var(–ink);
color: var(–parchment);
font-family: ‘Libre Baskerville’, serif;
min-height: 100vh;
overflow-x: hidden;
}

/* ── NOISE TEXTURE OVERLAY ─────────────────────────── */
body::before {
content: ‘’;
position: fixed; inset: 0;
background-image: url(“data:image/svg+xml,%3Csvg viewBox=‘0 0 256 256’ xmlns=‘http://www.w3.org/2000/svg’%3E%3Cfilter id=‘noise’%3E%3CfeTurbulence type=‘fractalNoise’ baseFrequency=‘0.9’ numOctaves=‘4’ stitchTiles=‘stitch’/%3E%3C/filter%3E%3Crect width=‘100%25’ height=‘100%25’ filter=‘url(%23noise)’ opacity=‘0.035’/%3E%3C/svg%3E”);
pointer-events: none; z-index: 9999; opacity: 0.4;
}

/* ── COVER ─────────────────────────────────────────── */
.cover {
min-height: 100vh;
display: flex; flex-direction: column;
align-items: center; justify-content: center;
position: relative;
background: radial-gradient(ellipse at 50% 60%, #3d2010 0%, #1a1410 55%, #0d0b08 100%);
padding: 60px 40px;
overflow: hidden;
}

.cover::before {
content: ‘’;
position: absolute; bottom: 0; left: 0; right: 0;
height: 1px;
background: linear-gradient(90deg, transparent, var(–gold), var(–ember), var(–gold), transparent);
}

/* Smoke wisps */
.smoke-bg {
position: absolute; inset: 0; overflow: hidden; pointer-events: none;
}
.wisp {
position: absolute;
border-radius: 50%;
filter: blur(80px);
opacity: 0.06;
animation: drift 18s ease-in-out infinite alternate;
}
.wisp:nth-child(1) { width: 500px; height: 500px; background: var(–ember); top: -100px; left: -100px; animation-delay: 0s; }
.wisp:nth-child(2) { width: 400px; height: 600px; background: var(–gold); top: 20%; right: -150px; animation-delay: -6s; }
.wisp:nth-child(3) { width: 600px; height: 300px; background: var(–rust); bottom: -50px; left: 20%; animation-delay: -12s; }

@keyframes drift {
from { transform: translate(0, 0) scale(1); }
to   { transform: translate(30px, -40px) scale(1.1); }
}

.brand-lockup {
text-align: center;
position: relative; z-index: 2;
}

.brand-rule {
display: flex; align-items: center; gap: 16px;
margin-bottom: 12px;
opacity: 0; animation: fadeUp 0.8s ease forwards 0.2s;
}
.brand-rule::before, .brand-rule::after {
content: ‘’;
flex: 1; height: 1px;
background: linear-gradient(90deg, transparent, var(–gold));
}
.brand-rule::after {
background: linear-gradient(90deg, var(–gold), transparent);
}
.brand-rule span {
color: var(–gold);
font-family: ‘Raleway’, sans-serif;
font-size: 11px; letter-spacing: 4px; text-transform: uppercase;
font-weight: 600;
}

.brand-name {
font-family: ‘Playfair Display’, serif;
font-size: clamp(64px, 10vw, 120px);
font-weight: 900;
line-height: 0.9;
color: var(–parchment);
letter-spacing: -1px;
opacity: 0; animation: fadeUp 1s ease forwards 0.4s;
}
.brand-name .amp {
color: var(–ember);
font-style: italic;
display: inline-block;
transform: rotate(-3deg);
font-weight: 700;
}

.brand-tagline {
font-family: ‘Playfair Display’, serif;
font-style: italic;
font-size: clamp(15px, 2vw, 20px);
color: var(–ash);
letter-spacing: 1px;
margin-top: 16px;
opacity: 0; animation: fadeUp 1s ease forwards 0.6s;
}

.brand-address {
font-family: ‘Raleway’, sans-serif;
font-size: 11px; letter-spacing: 3px; text-transform: uppercase;
color: var(–gold);
margin-top: 20px;
opacity: 0; animation: fadeUp 1s ease forwards 0.8s;
}

.cover-details {
display: flex; gap: 40px; margin-top: 40px;
opacity: 0; animation: fadeUp 1s ease forwards 1s;
}
.cover-detail {
text-align: center;
border: 1px solid rgba(212,160,67,0.25);
padding: 12px 24px;
border-radius: 2px;
}
.cover-detail .label {
font-family: ‘Raleway’, sans-serif;
font-size: 9px; letter-spacing: 3px; text-transform: uppercase;
color: var(–ash); margin-bottom: 4px;
}
.cover-detail .value {
font-family: ‘Playfair Display’, serif;
font-size: 13px; color: var(–gold);
}

.scroll-hint {
position: absolute; bottom: 30px;
font-family: ‘Raleway’, sans-serif;
font-size: 10px; letter-spacing: 3px; text-transform: uppercase;
color: var(–ash);
display: flex; flex-direction: column; align-items: center; gap: 8px;
opacity: 0; animation: fadeUp 1s ease forwards 1.4s;
}
.scroll-hint::after {
content: ‘’;
width: 1px; height: 30px;
background: linear-gradient(180deg, var(–gold), transparent);
animation: pulse 2s ease-in-out infinite;
}
@keyframes pulse { 0%,100%{opacity:.3} 50%{opacity:1} }

/* ── MENU BODY ─────────────────────────────────────── */
.menu-body {
max-width: 1100px;
margin: 0 auto;
padding: 0 32px 80px;
}

/* ── SECTION ───────────────────────────────────────── */
.section {
margin-top: 80px;
opacity: 0;
transform: translateY(24px);
transition: opacity 0.7s ease, transform 0.7s ease;
}
.section.visible { opacity: 1; transform: translateY(0); }

.section-header {
display: flex; align-items: center; gap: 20px;
margin-bottom: 32px;
padding-bottom: 16px;
border-bottom: 1px solid rgba(212,160,67,0.2);
}
.section-icon {
width: 44px; height: 44px;
background: linear-gradient(135deg, var(–ember), var(–rust));
border-radius: 4px;
display: flex; align-items: center; justify-content: center;
font-size: 20px; flex-shrink: 0;
box-shadow: 0 4px 16px rgba(200,97,26,0.35);
}
.section-meta { flex: 1; }
.section-title {
font-family: ‘Playfair Display’, serif;
font-size: 28px; font-weight: 700;
color: #ffffff;
line-height: 1;
}
.section-subtitle {
font-family: ‘Raleway’, sans-serif;
font-size: 11px; letter-spacing: 2px; text-transform: uppercase;
color: #c8a96e; margin-top: 4px;
}

/* ── ANALYSIS CALLOUT ──────────────────────────────── */
.analysis-bar {
background: linear-gradient(135deg, #0d1e2e 0%, #112233 100%);
border-left: 3px solid var(–gold);
border-radius: 0 4px 4px 0;
padding: 16px 20px;
margin-bottom: 28px;
position: relative;
overflow: hidden;
}
.analysis-bar::before {
content: ‘▲ MENU ANALYSIS’;
position: absolute; top: 10px; right: 14px;
font-family: ‘Raleway’, sans-serif;
font-size: 8px; letter-spacing: 2px;
color: rgba(212,160,67,0.4);
}
.analysis-bar p {
font-family: ‘Raleway’, sans-serif;
font-size: 12px; line-height: 1.6;
color: #a8c4d8;
}
.analysis-bar strong { color: var(–gold); font-weight: 600; }

/* ── ITEM GRID ─────────────────────────────────────── */
.items-grid {
display: grid;
grid-template-columns: repeat(auto-fill, minmax(460px, 1fr));
gap: 2px;
}
.items-grid.full-width { grid-template-columns: 1fr; }
.items-grid.three-col { grid-template-columns: repeat(3, 1fr); }

/* ── MENU ITEM ─────────────────────────────────────── */
.item {
padding: 18px 20px;
border-bottom: 1px solid rgba(255,255,255,0.05);
position: relative;
transition: background 0.2s ease;
cursor: default;
}
.item:hover { background: rgba(255,255,255,0.025); }

.item-top {
display: flex; align-items: flex-start;
justify-content: space-between; gap: 12px;
}
.item-left { flex: 1; }

.item-name {
font-family: ‘Playfair Display’, serif;
font-size: 16px; font-weight: 600;
color: var(–parchment);
line-height: 1.2;
display: flex; align-items: center; gap: 8px; flex-wrap: wrap;
}

.item-desc {
font-family: ‘Libre Baskerville’, serif;
font-size: 12px; color: var(–ash);
margin-top: 5px; line-height: 1.55;
font-style: italic;
}

.item-price {
font-family: ‘Playfair Display’, serif;
font-size: 18px; font-weight: 700;
color: var(–gold);
white-space: nowrap;
line-height: 1.2;
}
.item-price .cents {
font-size: 12px; vertical-align: super; color: var(–ember);
}

/* ── TAGS ──────────────────────────────────────────── */
.tag {
display: inline-flex; align-items: center; gap: 3px;
font-family: ‘Raleway’, sans-serif;
font-size: 9px; letter-spacing: 0.8px; text-transform: uppercase;
font-weight: 700;
padding: 2px 7px; border-radius: 2px;
line-height: 1.4;
}
.tag-star    { background: var(–tag-star-bg); color: var(–tag-star); }
.tag-anchor  { background: var(–tag-anchor-bg); color: var(–tag-anchor); }
.tag-decoy   { background: var(–tag-decoy-bg); color: var(–tag-decoy); }
.tag-puzzle  { background: #e8f0ff; color: #2a3a7c; }
.tag-popular { background: #2d1a00; color: var(–ember); border: 1px solid rgba(200,97,26,0.3); }
.tag-new     { background: rgba(212,160,67,0.15); color: var(–gold); border: 1px solid rgba(212,160,67,0.3); }
.tag-shore   { background: #0d1e2e; color: #5b9fd8; border: 1px solid rgba(91,159,216,0.3); }

/* ── FEATURED ITEM ─────────────────────────────────── */
.item.featured {
background: linear-gradient(135deg, rgba(200,97,26,0.08), rgba(200,97,26,0.03));
border-left: 3px solid var(–ember);
padding-left: 17px;
}
.item.featured .item-name { color: #f0d9bc; }

/* ── ANCHOR ITEM (price anchoring decoy) ───────────── */
.item.anchor {
border-left: 3px solid var(–gold);
padding-left: 17px;
}

/* ── PSYCHOLOGY NOTE (hover tooltip) ──────────────── */
.psych-note {
display: none;
font-family: ‘Raleway’, sans-serif;
font-size: 11px; line-height: 1.5;
color: #a8c4d8;
margin-top: 8px;
padding: 8px 12px;
background: rgba(13,30,46,0.85);
border-left: 2px solid var(–gold);
border-radius: 0 3px 3px 0;
}
.item:hover .psych-note { display: block; }

/* ── DIVIDER ───────────────────────────────────────── */
.ornament-divider {
display: flex; align-items: center; gap: 16px;
margin: 60px 0 0;
opacity: 0.4;
}
.ornament-divider::before, .ornament-divider::after {
content: ‘’; flex: 1; height: 1px;
background: linear-gradient(90deg, transparent, var(–gold));
}
.ornament-divider::after { background: linear-gradient(90deg, var(–gold), transparent); }
.ornament-divider span { color: var(–gold); font-size: 14px; }

/* ── RETAIL SHELF ──────────────────────────────────── */
.retail-grid {
display: grid;
grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
gap: 16px;
}
.retail-card {
background: rgba(255,255,255,0.03);
border: 1px solid rgba(212,160,67,0.15);
border-radius: 4px;
padding: 20px 16px;
text-align: center;
transition: border-color 0.2s, transform 0.2s;
}
.retail-card:hover { border-color: rgba(212,160,67,0.4); transform: translateY(-2px); }
.retail-card .r-icon { font-size: 28px; margin-bottom: 10px; }
.retail-card .r-name {
font-family: ‘Playfair Display’, serif;
font-size: 14px; color: var(–parchment);
margin-bottom: 4px;
}
.retail-card .r-size {
font-family: ‘Raleway’, sans-serif;
font-size: 10px; letter-spacing: 1px; color: var(–ash);
margin-bottom: 10px;
}
.retail-card .r-price {
font-family: ‘Playfair Display’, serif;
font-size: 22px; color: var(–gold); font-weight: 700;
}
.retail-card .r-margin {
font-family: ‘Raleway’, sans-serif;
font-size: 9px; color: var(–ember);
margin-top: 4px; letter-spacing: 1px;
}

/* ── ANALYSIS PANEL ────────────────────────────────── */
.analysis-panel {
margin-top: 80px;
background: linear-gradient(135deg, #0a1520 0%, #0d1e2e 100%);
border: 1px solid rgba(212,160,67,0.15);
border-radius: 6px;
padding: 40px;
opacity: 0; transform: translateY(24px);
transition: opacity 0.7s ease, transform 0.7s ease;
}
.analysis-panel.visible { opacity: 1; transform: translateY(0); }

.analysis-panel-header {
display: flex; align-items: center; gap: 14px;
margin-bottom: 32px;
padding-bottom: 20px;
border-bottom: 1px solid rgba(212,160,67,0.15);
}
.analysis-badge {
background: var(–gold);
color: var(–ink);
font-family: ‘Raleway’, sans-serif;
font-size: 9px; letter-spacing: 2px; text-transform: uppercase;
font-weight: 700;
padding: 5px 10px; border-radius: 2px;
white-space: nowrap;
}
.analysis-panel-title {
font-family: ‘Playfair Display’, serif;
font-size: 22px; color: var(–parchment);
}

.analysis-grid {
display: grid;
grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
gap: 24px;
}
.analysis-card {
background: rgba(255,255,255,0.025);
border-radius: 4px;
padding: 24px;
border-top: 2px solid var(–gold);
}
.analysis-card.highlight { border-top-color: var(–ember); }
.analysis-card.info { border-top-color: #5b9fd8; }

.ac-title {
font-family: ‘Playfair Display’, serif;
font-size: 16px; font-weight: 700;
color: var(–parchment);
margin-bottom: 10px;
}
.ac-source {
font-family: ‘Raleway’, sans-serif;
font-size: 9px; letter-spacing: 1px; text-transform: uppercase;
color: var(–ash); margin-bottom: 10px;
}
.ac-body {
font-family: ‘Raleway’, sans-serif;
font-size: 12px; line-height: 1.7;
color: #8ba0b0;
}
.ac-body strong { color: var(–gold); }
.ac-body em { color: var(–highlight); font-style: normal; }

/* ── MATRIX TABLE ──────────────────────────────────── */
.matrix-table {
width: 100%; border-collapse: collapse;
margin-top: 16px;
}
.matrix-table th {
font-family: ‘Raleway’, sans-serif;
font-size: 9px; letter-spacing: 2px; text-transform: uppercase;
color: var(–ash); padding: 8px 12px;
text-align: left;
border-bottom: 1px solid rgba(255,255,255,0.08);
}
.matrix-table td {
font-family: ‘Raleway’, sans-serif;
font-size: 11px; color: #8ba0b0;
padding: 9px 12px;
border-bottom: 1px solid rgba(255,255,255,0.04);
}
.matrix-table tr:hover td { color: var(–parchment); }
.matrix-table td:first-child { color: var(–parchment); font-weight: 600; }
.matrix-table td.green  { color: #66bb6a; }
.matrix-table td.amber  { color: var(–gold); }
.matrix-table td.blue   { color: #5b9fd8; }
.matrix-table td.red    { color: #ef5350; }

/* ── FOOTER ────────────────────────────────────────── */
.menu-footer {
margin-top: 80px;
padding: 40px;
background: rgba(0,0,0,0.3);
border-top: 1px solid rgba(212,160,67,0.15);
text-align: center;
}
.footer-brand {
font-family: ‘Playfair Display’, serif;
font-size: 24px; color: var(–gold);
margin-bottom: 8px;
}
.footer-tagline {
font-family: ‘Raleway’, sans-serif;
font-size: 11px; letter-spacing: 3px; text-transform: uppercase;
color: var(–ash);
margin-bottom: 20px;
}
.footer-info {
display: flex; justify-content: center; gap: 40px; flex-wrap: wrap;
font-family: ‘Raleway’, sans-serif;
font-size: 11px; color: var(–ash);
}
.footer-info span { display: flex; align-items: center; gap: 6px; }

/* ── UTILITY ───────────────────────────────────────── */
@keyframes fadeUp {
from { opacity: 0; transform: translateY(20px); }
to   { opacity: 1; transform: translateY(0); }
}

.dots { letter-spacing: 2px; flex: 1;
border-bottom: 1px dotted rgba(255,255,255,0.1);
margin: 0 8px; position: relative; top: -3px; }

/* Shore Club banner */
.loyalty-banner {
background: linear-gradient(135deg, #1a2d1a, #0f1f0f);
border: 1px solid rgba(100,180,100,0.25);
border-radius: 4px;
padding: 20px 28px;
display: flex; align-items: center; gap: 20px;
margin-top: 60px;
opacity: 0; transform: translateY(20px);
transition: opacity 0.7s ease 0.2s, transform 0.7s ease 0.2s;
}
.loyalty-banner.visible { opacity: 1; transform: translateY(0); }
.loyalty-icon { font-size: 32px; flex-shrink: 0; }
.loyalty-text .l-title {
font-family: ‘Playfair Display’, serif;
font-size: 18px; color: #a8d8a8; margin-bottom: 4px;
}
.loyalty-text .l-sub {
font-family: ‘Raleway’, sans-serif;
font-size: 11px; color: #6a9a6a; letter-spacing: 1px;
}
.loyalty-reward {
margin-left: auto;
text-align: center;
background: rgba(100,180,100,0.1);
border: 1px solid rgba(100,180,100,0.2);
border-radius: 3px;
padding: 10px 20px;
}
.loyalty-reward .pts {
font-family: ‘Playfair Display’, serif;
font-size: 22px; color: #a8d8a8; display: block;
}
.loyalty-reward .pts-label {
font-family: ‘Raleway’, sans-serif;
font-size: 9px; letter-spacing: 2px; text-transform: uppercase; color: #6a9a6a;
}

@media (max-width: 600px) {
.items-grid { grid-template-columns: 1fr; }
.items-grid.three-col { grid-template-columns: 1fr 1fr; }
.cover-details { flex-direction: column; align-items: center; }
.menu-body { padding: 0 16px 60px; }
.analysis-grid { grid-template-columns: 1fr; }
.analysis-panel { padding: 24px; }
}
</style>

</head>
